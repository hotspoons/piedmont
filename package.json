{
  "name": "piedmont",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "An open-world driving game on real roads: the game and its editors, the world baker, the services and the asset pipelines.",
  "workspaces": [
    "vendor/arcade/packages/engine",
    "vendor/arcade/packages/enginesim",
    "vendor/arcade/packages/stunt-pieces",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "arcade:bump": "node scripts/arcade-bump.mjs",
    "preinstall": "node scripts/setup.mjs --check",
    "dev": "npm run dev -w apps/game",
    "build": "tsc -b && npm run build -w apps/game",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:pull-policy": "node scripts/check-pull-policy.mjs",
    "check:links": "node scripts/check-links.mjs",
    "icons": "node scripts/heroicons.mjs",
    "program-types": "node scripts/gen-program-types.mjs",
    "bridge": "node scripts/bridge.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.0",
    "@types/webxr": "^0.5.24",
    "@types/ws": "^8.18.1",
    "draco3dgltf": "^1.5.7",
    "esbuild": "^0.28.2",
    "heroicons": "^2.2.0",
    "meshoptimizer": "^1.2.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.0",
    "ws": "^8.18.3"
  }
}
