{
	"name": "piedmont",
	// Based on siomporas-arcade's container (same image, bind mounts, cross-platform
	// initializeCommand, post-create.sh and Blender build volume), extended for everything piedmont
	// builds and tests: Docker-in-Docker for the compose stack and the images, kubectl + Helm for the
	// cluster, and the bake's Python/GDAL/PDAL toolchain (post-create.sh).
	// Node 24, the active LTS (22 is maintenance-only, to April 2027). The image is Debian trixie.
	"image": "mcr.microsoft.com/devcontainers/typescript-node:24",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		// A Docker daemon of our own inside the container: `docker build` for the five images and
		// `docker compose up` for the local stack (deploy/docker), without touching the host's.
		//
		// "moby": false, i.e. Docker CE from Docker's own apt repository. The base image now builds on
		// Debian trixie, which has no moby-cli packages, and the feature refuses "moby": true there
		// (Rich's first container build, 2026-10-11).
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false,
			"installDockerBuildx": true,
			"installDockerComposeSwitch": true
		}
	},
	// opencode first, and on its own: onCreateCommand finishes before the editor connects, so the binary
	// is there when OpenChamber activates. post-create.sh runs after the editor is up and takes far longer.
	"onCreateCommand": "bash .devcontainer/opencode.sh",
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	// NOT host networking, unlike the arcade's container. Docker-in-Docker runs its own dockerd, and in
	// the host's network namespace that daemon would create its bridge and iptables rules on the host
	// beside the host's own Docker — two daemons fighting over docker0. The dev servers are reached
	// through forwarded ports instead, which every editor that opens a dev container provides.
	//   5185  the game's dev server (also the site editor, /editor.html)
	//   5186  the game against a remote deployment's data (`just remote`)
	//   5212  the world editor page (`just worldeditor-app`)
	//   8780  the world editor service and its MCP endpoint (`just worldeditor-svc`)
	//   8770  the asset service
	"forwardPorts": [5185, 5186, 5212, 8780, 8770],
	"portsAttributes": {
		"5185": { "label": "game" },
		"5186": { "label": "game (remote data)" },
		"5212": { "label": "world editor page" },
		"8780": { "label": "world editor service + MCP" },
		"8770": { "label": "asset service" }
	},
	// Runs on the HOST before the container exists, on any host OS: cmd.exe/PowerShell on Windows, or
	// the `sh` fallback everywhere else. It makes every bind-mount source, so Docker never creates them
	// root-owned (or fails on a missing file): ~/.kube, ~/.claude, ~/.claude.json, ~/piedmont-data, and
	// opencode's and OpenChamber's directories under .devhome/ in this checkout (the cwd here).
	"initializeCommand": "cmd.exe /c powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; New-Item -ItemType Directory -Force -Path $env:USERPROFILE\\.kube, $env:USERPROFILE\\.claude, $env:USERPROFILE\\piedmont-data, .devhome\\.opencode, .devhome\\.config\\opencode, .devhome\\.local\\share\\opencode, .devhome\\.local\\state\\opencode, .devhome\\.cache\\opencode, .devhome\\.config\\openchamber, .devhome\\.agents | Out-Null; if (!(Test-Path $env:USERPROFILE\\.claude.json)) { Set-Content -Path $env:USERPROFILE\\.claude.json -Value '{}' }\" || sh -c 'mkdir -p \"$HOME/.kube\" \"$HOME/.claude\" \"$HOME/piedmont-data\" .devhome/.opencode .devhome/.config/opencode .devhome/.local/share/opencode .devhome/.local/state/opencode .devhome/.cache/opencode .devhome/.config/openchamber .devhome/.agents && touch \"$HOME/.claude.json\"'",
	"containerEnv": {
		// the bake's caches and sites, the world editor's volume in development: the bind mount below
		"PIEDMONT_DATA": "${containerWorkspaceFolder}/data"
	},
	"mounts": [
		// Blender 5.1 is a from-source build on arm64 (see .devcontainer/build-blender.sh) and takes
		// the better part of an hour. Everything under /home/node lives in the container layer, so
		// without this a rebuild throws the whole thing away and starts over, silently, in the
		// background. A named volume outlives rebuilds; `make` is then incremental and the next
		// container is minutes rather than an hour. Delete the volume to force a clean build.
		"source=piedmont-blender-build,target=/home/node/.cache/blender-source,type=volume",
		// Docker-in-Docker's images and build cache, kept across rebuilds for the same reason.
		"source=piedmont-docker-data,target=/var/lib/docker,type=volume",
		// $PIEDMONT_DATA: the bake's downloaded lidar/imagery/OSM cache and the baked worlds — tens of
		// gigabytes that must survive a rebuild and stay out of git. ~/piedmont-data on the host; to
		// keep it elsewhere, make that a symlink to where it lives.
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/piedmont-data,target=${containerWorkspaceFolder}/data,type=bind,consistency=cached",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.kube,target=/home/node/.kube,type=bind,consistency=cached",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
		// opencode and OpenChamber: binary, config, auth, sessions, state, caches and skills, from
		// .devhome/ in this checkout (gitignored), so a rebuild keeps all of it. Each .devhome/<path> is
		// ~/<path>. The container's own, never the host's ~/.config/opencode and ~/.local/share/opencode:
		// one SQLite database shared by a host and a container opencode is how the old setup corrupted
		// it, and OpenCode 2 migrates a 1.x database in place. Why mounts and not symlinks, and the
		// install: .devcontainer/opencode.sh (keep its list in step with these and initializeCommand).
		"source=${localWorkspaceFolder}/.devhome/.opencode,target=/home/node/.opencode,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.config/opencode,target=/home/node/.config/opencode,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.local/share/opencode,target=/home/node/.local/share/opencode,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.local/state/opencode,target=/home/node/.local/state/opencode,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.cache/opencode,target=/home/node/.cache/opencode,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.config/openchamber,target=/home/node/.config/openchamber,type=bind",
		"source=${localWorkspaceFolder}/.devhome/.agents,target=/home/node/.agents,type=bind"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"oxc.oxc-vscode",
				"esbenp.prettier-vscode",
				"slevesque.shader",
				"anthropic.claude-code",
				"ms-python.python",
				"redhat.vscode-yaml",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"ms-azuretools.vscode-docker",
				// OpenChamber: a UI for opencode inside the editor (opencode itself: opencode.sh)
				"FedaykinDev.openchamber"
			],
			"settings": {
				"editor.formatOnSave": false,
				"typescript.tsdk": "node_modules/typescript/lib",
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/bake/.venv/bin/python",
				// opencode's database, logs and snapshots churn under .devhome/; nothing there to watch
				"files.watcherExclude": { "**/.devhome/**": true }
			}
		}
	}
}
