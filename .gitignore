# Node
node_modules/
dist/
apps/*/dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# Editor/OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store

# Claude Code local state (worktrees, session scratch)
.claude/

# the arcade packages: vendor/arcade is a LINK made by `npm run setup` (scripts/setup.mjs) to
# ext/siomporas-arcade or to the pinned ref fetched into .cache/arcade/<ref>. Never committed.
vendor/
.cache/

# ext/ holds other repositories checked out beside this one (siomporas-arcade, gaussworks); only
# its README is ours
ext/*
!ext/README.md

# ad-hoc dev probe scripts (throwaway; kept local, never committed)
probes/*
!probes/*.mjs
!probes/*.py
_*.mjs
shots/
.tunnel-url*
apps/*/test/_*.test.ts

# $PIEDMONT_DATA: the bake's downloaded lidar/imagery/OSM cache, the baked sites, levels and splats
# (tens of GB, rebuildable). Both forms, because the trailing-slash rule matches directories only and
# a symlink to a shared copy slips past it.
/data/
/data
# the bake's venv and its ktx encoder
bake/.venv/
bake/.venv
bake/.bin

# the game: generated textures (pipelines/surfaces/gen.py) and generated props
# (probes/editor-assets.mjs) are regenerable and large, so they are tracked in Git LFS rather than
# ignored — the app image ships them so a fresh editor draws the built-ins (see .gitattributes).
# catalog.json and the vendored Draco decoder are ordinary files and stay.

# python bytecode
__pycache__/
*.pyc

# road-and-car: synthetic tiled-site fixture (probes/make-tiles.py), regenerable, not a bake
apps/game/public/testdata/

# the local editor's data dir (just editor-local) — a scratch volume, never content
.local-editor-data/
.local-assets/

# the asset service's local catalog — a working store, never content
services/assetsvc/data/
probes/.build/

# credentials and per-machine agent config: never committed
.mcp.json
.env
*.kubeconfig

# the sound bank's tool venv and downloaded source packs (rebuildable; the cuts under
# apps/game/public/sounds ARE committed)
pipelines/sounds/.venv/
pipelines/sounds/.venv
pipelines/sounds/.cache/
pipelines/sounds/.cache

# the dev container's opencode and OpenChamber (binary, config with credentials, sessions, state),
# bind-mounted into ~ by .devcontainer/devcontainer.json so a rebuild keeps them. Never committed.
/.devhome/
/.devhome
