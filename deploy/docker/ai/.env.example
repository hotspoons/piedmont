# deploy/docker/ai/.env — the optional AI stack. Copy to .env and edit. Placeholders only.

# where model weights and outputs live on this host (tens of GB each); relative to deploy/docker/ai/
PIEDMONT_AI_DIR=./data
# FLUX.2-dev is a gated model on Hugging Face: accept its licence there, then a read token here.
# TRELLIS uses it too, for two gated helper models; without it, ungated mirrors and a warning.
HF_TOKEN=

# ---- which GPU each model gets (nvidia-smi -L numbering; one id, or a comma list) ----------------
FLUX_GPU=0
TRELLIS_GPU=1

# ---- ports ---------------------------------------------------------------------------------------
# The direct ports have NO authentication, so they listen on this host only. The main stack (on
# another machine, or this one) comes in through the gateway below, with its key. 0.0.0.0 opens the
# direct ports to the network instead: a trusted network only.
AI_BIND=127.0.0.1
FLUX_PORT=18090
TRELLIS_PORT=8500

# ---- images and arguments ------------------------------------------------------------------------
FLUX_IMAGE=vllm/vllm-omni:v0.28.0
# everything after `vllm serve`. Keep --served-model-name flux.2-dev: assetsvc asks for that id.
FLUX_ARGS=black-forest-labs/FLUX.2-dev --omni --host 0.0.0.0 --port 8000 --served-model-name flux.2-dev
TRELLIS_IMAGE=ghcr.io/hotspoons/piedmont-recon:latest
TRELLIS_MODEL_REPO=microsoft/TRELLIS.2-4B
# compute capabilities to build TRELLIS for, when building it here (8.6 = RTX 30xx/A10, 8.9 = RTX 40xx/L4/L40, 9.0 = H100/GH200)
TRELLIS_CUDA_ARCH=8.0;8.6;8.9;9.0

# ---- the gateway (profile gateway): one port, a bearer key — how the main stack gets in --------
GATEWAY_IMAGE=nginx:1.27-alpine
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8443
# a long random string; the main stack sends it as PIEDMONT_IMAGE_MODEL_KEY and PIEDMONT_MESH_MODEL_KEY
AI_API_KEY=
