# deploy/docker/.env — copy this to .env and edit. EVERY setting the Docker install reads is here.
#
# Read twice: by `docker compose` for the outer file (paths, ports, the core image), and passed into
# the core, which hands the PIEDMONT_EDITOR_* / ASSETSVC_* / PIEDMONT_*_MODEL_* values on to the services.
# An empty value is treated as UNSET (the service's own default applies). Values are one line each.
# Placeholders only: this file is checked in, your .env is not (deploy/docker/.gitignore).

# ---- the host -----------------------------------------------------------------------------------
# THE shared directory. Everything that must survive a restart is under it: worlds, bakes, runs,
# the Overpass databases, the asset catalog. Back this up. (Layout: docs/DOCKER.md.)
# Relative paths are relative to deploy/docker/; the default needs no sudo and sits inside Docker
# Desktop's file sharing. An absolute path (e.g. /srv/piedmont, a big disk) works the same.
PIEDMONT_HOST_DIR=./data
# where the editor listens on the host
PIEDMONT_HOST_BIND=0.0.0.0
PIEDMONT_HOST_PORT=8780
# the MinIO console, bound to 127.0.0.1 only (profile minio)
PIEDMONT_MINIO_CONSOLE_PORT=9001
# the core image: published by .github/workflows/core-image.yml (latest, sha-<short>), pulled on
# every `up`. To run one built from this checkout, name it locally (piedmont-core:local) and `up --build`.
PIEDMONT_CORE_IMAGE=ghcr.io/hotspoons/piedmont-core:latest
# 0 builds the core without the NVIDIA Container Toolkit (a host that will never have a GPU)
PIEDMONT_WITH_NVIDIA=1
# extra services, comma-separated: overpass-na, overpass-eu (each a continent: TBs and a day to import), minio
PIEDMONT_PROFILES=
# start only these services (space-separated), e.g. "worldeditor assetsvc" to bake against the public
# Overpass mirrors without importing one; empty starts all of them
PIEDMONT_SERVICES=
# extra flags for the core's own dockerd, e.g. --storage-driver=vfs on a host where overlay-on-overlay fails
PIEDMONT_DOCKERD_ARGS=
# minutes a service may stay unhealthy before the core restarts it
PIEDMONT_UNHEALTHY_RESTART_MIN=5

# ---- registries ---------------------------------------------------------------------------------
# ghcr.io/hotspoons/* may be private. A GitHub username and a token with read:packages.
GHCR_USER=
GHCR_TOKEN=

# ---- images -------------------------------------------------------------------------------------
# Every image is pulled on every start (and by the runner before every bake container), as in the
# cluster. Pin a sha-<commit> tag for a reproducible host; it is still pulled, and simply does not change.
PIEDMONT_EDITOR_IMAGE=ghcr.io/hotspoons/piedmont-worldeditor:latest
ASSETSVC_IMAGE=ghcr.io/hotspoons/piedmont-assetsvc:latest
OVERPASS_IMAGE=wiktorn/overpass-api:latest
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# ---- Overpass: the default instance (`overpass`) -------------------------------------------------
# Maryland, as the chart's default. Any Geofabrik extract works; change all four together, and wipe
# ${PIEDMONT_HOST_DIR}/volumes/overpass-db first (an instance re-imports only when /db/init_done is missing).
OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america/us/maryland-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us/maryland-updates/
OVERPASS_PRIMARY_ID=us/maryland
OVERPASS_PRIMARY_POLY=https://download.geofabrik.de/north-america/us/maryland.poly

# ---- the world editor: which Overpass, and what each holds ---------------------------------------
# Ours first; the public mirrors are appended. Add http://overpass-na/api/interpreter (and
# overpass-na=north-america below) when the overpass-na profile is on, likewise overpass-eu=europe.
PIEDMONT_EDITOR_OVERPASS_URL=http://overpass/api/interpreter
PIEDMONT_EDITOR_OVERPASS_REGIONS=overpass=us/maryland
# the image an osm-import runs in: the instances' own (keep it equal to OVERPASS_IMAGE)
PIEDMONT_EDITOR_OSM_IMPORT_IMAGE=wiktorn/overpass-api:latest
PIEDMONT_EDITOR_OVERPASS_TIMEOUT=
PIEDMONT_EDITOR_OVERPASS_DEADLINE=
PIEDMONT_EDITOR_OVERPASS_DOWN_FOR=
PIEDMONT_EDITOR_NOMINATIM=
PIEDMONT_EDITOR_NOMINATIM_INTERVAL=
# off: no Natural Earth borders on the map (they are fetched once from GitHub and cached)
PIEDMONT_EDITOR_BASEMAP=

# ---- the bake -----------------------------------------------------------------------------------
PIEDMONT_EDITOR_BAKE_IMAGE=ghcr.io/hotspoons/piedmont-bake:latest
# Per bake container. CPU limits above the host's core count are clamped; memory is a hard cap and an
# OOM kill is reported as one. The cluster default is 64 CPU / 384Gi, sized for a GH200 node.
PIEDMONT_EDITOR_BAKE_RESOURCES={"requests":{"cpu":"4","memory":"16Gi"},"limits":{"cpu":"16","memory":"96Gi"}}
PIEDMONT_EDITOR_HORIZON_M=
# auto-shard above this half-width (m; 5000 by default, 0 = never), blocks of SIDE m, at most MAX blocks
PIEDMONT_EDITOR_SHARD_ABOVE_M=
PIEDMONT_EDITOR_SHARD_SIDE_M=
PIEDMONT_EDITOR_MAX_SHARDS=

# ---- the Docker runner --------------------------------------------------------------------------
# Bake containers at once; the rest wait. A big shard peaks above 100 GiB, so size this to memory.
# Also settable in the editor (Settings → Docker runner), which wins over this.
PIEDMONT_EDITOR_DOCKER_MAX_PARALLEL=1
# GPUs the runner may hand out, one set per pod: a count (2 = ids 0,1) or ids (0,2). 0 = none known.
# Needs docker-compose.gpu.yml.
PIEDMONT_EDITOR_DOCKER_GPUS=0
# /dev/shm for each job container
PIEDMONT_EDITOR_DOCKER_SHM=1Gi
# a claim stored somewhere other than ${PIEDMONT_HOST_DIR}/volumes/<claim>, as JSON {"claim":"/srv/piedmont/…"}
# (paths here are INSIDE the core, where PIEDMONT_HOST_DIR is mounted at /srv/piedmont)
PIEDMONT_EDITOR_DOCKER_CLAIMS=
# pin the Engine API version (e.g. 1.44); empty speaks the daemon's own
PIEDMONT_EDITOR_DOCKER_API_VERSION=

# ---- publishing a world to a bucket (the bake's `publish`) ---------------------------------------
# R2 / S3 / MinIO. With the minio profile: PIEDMONT_EDITOR_S3_ENDPOINT=http://minio:9000, bucket worlds.
PIEDMONT_EDITOR_S3_BUCKET=
PIEDMONT_EDITOR_S3_ENDPOINT=
PIEDMONT_EDITOR_S3_REGION=
PIEDMONT_EDITOR_S3_PREFIX=
# the Secret name the bake reads its keys from; the core writes it from the two below
PIEDMONT_EDITOR_S3_SECRET=publish-s3
PUBLISH_S3_ACCESS_KEY_ID=
PUBLISH_S3_SECRET_ACCESS_KEY=

# ---- the editor, everything else ---------------------------------------------------------------
# `repo` seeds the checked-in sites.json on an empty volume; empty starts with no worlds
PIEDMONT_EDITOR_SEED_SITES=
PIEDMONT_EDITOR_CORS=
# the URL agents use for MCP, when they come in by a different route than the browser
PIEDMONT_EDITOR_PUBLIC_URL=
# set to fix the MCP token (else minted on first start and shown in the Agent tab); off disables auth
PIEDMONT_EDITOR_MCP_TOKEN=
PIEDMONT_EDITOR_MCP_AUTH=
PIEDMONT_EDITOR_UPLOAD_CHUNK_MIB=
PIEDMONT_EDITOR_ARCHIVE_MAX_MB=
PIEDMONT_EDITOR_BLENDER_AUTOSTART=true
# the Deploy panel's Cloudflare token (else typed into the panel, and forgotten on restart)
CLOUDFLARE_API_TOKEN=

# ---- splat training (gaussworks; needs GPUs) ----------------------------------------------------
# On Docker the batch tier runs: a leader container and N workers sharing an output directory.
PIEDMONT_EDITOR_SPLAT_IMAGE=ghcr.io/hotspoons/gaussworks:latest
PIEDMONT_EDITOR_SPLAT_CONFIG=
PIEDMONT_EDITOR_SPLAT_SEAM_MAX=
PIEDMONT_EDITOR_SPLAT_CODE_SHA=
PIEDMONT_EDITOR_SPLAT_RUNNER=
PIEDMONT_EDITOR_SPLAT_COMMAND=
PIEDMONT_EDITOR_SPLAT_ARGS=
PIEDMONT_EDITOR_SPLAT_OUTPUT_SIZE=
PIEDMONT_EDITOR_SPLAT_TTL=
PIEDMONT_EDITOR_GPU_RESOURCE=

# ---- the AI services: URLs only (deploy/docker/ai, or anyone's hosted endpoint) -----------------
# Unset = that feature says "not configured"; nothing else changes.
# Image generation and editing (flux.2): an OpenAI-images API — GET /v1/models,
# POST /v1/images/generations (JSON), POST /v1/images/edits (multipart). Model id flux.2-dev.
PIEDMONT_IMAGE_MODEL_URL=
# Image to 3D (TRELLIS.2): the recon-service API — POST /reconstruct (multipart `images`),
# GET /jobs/<id>, GET /jobs/<id>/asset, GET /readyz.
PIEDMONT_MESH_MODEL_URL=
# sent as `Authorization: Bearer <key>` on every call to that endpoint, when set
PIEDMONT_IMAGE_MODEL_KEY=
PIEDMONT_MESH_MODEL_KEY=
# informational only (the editor's /api/models): an OpenAI chat endpoint, e.g. a qwen server
PIEDMONT_TEXT_MODEL_URL=

# ---- the asset service --------------------------------------------------------------------------
ASSETSVC_CORS=
# which roster entry is the default image / mesh model (flux2-dev, trellis2)
ASSETSVC_IMAGE_MODEL=
ASSETSVC_MESH_MODEL=
# the catalog's S3 sync (/sync/push|pull); optional
ASSETSVC_S3_BUCKET=
ASSETSVC_S3_ENDPOINT=
ASSETSVC_S3_REGION=
ASSETSVC_S3_PREFIX=
ASSETSVC_S3_ACCESS_KEY_ID=
ASSETSVC_S3_SECRET_ACCESS_KEY=

# ---- MinIO (profile minio) ------------------------------------------------------------------------
MINIO_ROOT_USER=piedmont
# 8+ characters; the minio profile will not start without one
MINIO_ROOT_PASSWORD=
MINIO_BUCKETS=worlds assets
